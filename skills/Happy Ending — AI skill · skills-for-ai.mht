.sec-desc { margin: 9px 0px 0px; font-size: 12.5px; line-height: 1.5; color: var(--text-muted); }

.sec-link { display: inline-block; margin: 12px 0px 0px; font-size: 13px; color: var(--accent); text-decoration: none; }

.sec-link:hover { text-decoration: underline; }

.sfa-sel { position: relative; }

.sfa-sel > select { position: absolute; width: 1px; height: 1px; opacity: 0; pointer-events: none; margin: 0px; }

.sfa-sel-btn { display: flex; align-items: center; justify-content: space-between; gap: 8px; width: 100%; padding: 9px 12px; border: 1px solid var(--border); border-radius: 10px; background: var(--bg); color: var(--text); font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 14px; line-height: 1.4; cursor: pointer; text-align: left; transition: border-color 0.12s; }

.sfa-sel-btn:hover, .sfa-sel.is-open .sfa-sel-btn { border-color: var(--accent); }

.sfa-sel-btn svg { width: 16px; height: 16px; flex: 0 0 auto; color: var(--text-muted); transition: transform 0.15s; }

.sfa-sel.is-open .sfa-sel-btn svg { transform: rotate(180deg); }

.sfa-sel-btn.is-placeholder .sfa-sel-lbl { color: var(--text-faint); }

.sfa-sel-lbl { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.sfa-sel.is-disabled { opacity: 0.5; }

.sfa-sel.is-disabled .sfa-sel-btn { cursor: not-allowed; }

.sfa-sel-pop { position: absolute; top: calc(100% + 5px); left: 0px; right: 0px; z-index: 60; background: var(--surface); border: 1px solid var(--border); border-radius: 12px; box-shadow: rgba(0, 0, 0, 0.42) 0px 14px 40px; overflow: hidden; }

.sfa-sel-search { padding: 8px; border-bottom: 1px solid var(--border); }

.sfa-sel-search input { width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid var(--border); border-radius: 8px; background: var(--bg); color: var(--text); font-style: inherit; font-variant: inherit; font-weight: inherit; font-stretch: inherit; line-height: inherit; font-family: inherit; font-optical-sizing: inherit; font-size-adjust: inherit; font-kerning: inherit; font-feature-settings: inherit; font-variation-settings: inherit; font-language-override: inherit; font-size: 14px; }

.sfa-sel-search input:focus { outline: none; border-color: var(--accent); }

.sfa-sel-list { max-height: 280px; overflow-y: auto; padding: 5px; }

.sfa-sel-item { padding: 8px 11px; border-radius: 8px; font-size: 14px; color: var(--text); cursor: pointer; white-space: normal; }

.sfa-sel-item:hover, .sfa-sel-item.is-active { background: color-mix(in srgb,var(--accent) 15%,transparent); }

.sfa-sel-item.is-on { color: var(--accent); font-weight: 600; }

.sfa-sel-item[aria-disabled] { opacity: 0.4; cursor: default; }

.sfa-sel-empty { padding: 12px; text-align: center; color: var(--text-faint); font-size: 13.5px; }
