.bcrumb-back { display: inline-flex; align-items: center; gap: 5px; color: var(--text-muted); text-decoration: none; margin-right: 6px; transition: color 0.15s; }

.bcrumb-back[hidden] { display: none; }

.bcrumb-back:hover { color: var(--accent); }

