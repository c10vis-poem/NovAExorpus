.card-sec { display: flex; flex-wrap: wrap; gap: 6px; margin: 8px 0px 0px; }

.sec-chip { display: inline-flex; align-items: center; gap: 5px; font-size: 11px; font-weight: 600; padding: 3px 8px; border-radius: 7px; line-height: 1; white-space: nowrap; }

