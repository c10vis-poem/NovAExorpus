.btn.is-loading { pointer-events: none; position: relative; color: transparent !important; }

.btn.is-loading::after { content: ""; position: absolute; top: 50%; left: 50%; width: 15px; height: 15px; margin: -8px 0px 0px -8px; border-width: 2px; border-style: solid; border-color: rgb(255, 255, 255) rgba(255, 255, 255, 0.4) rgba(255, 255, 255, 0.4); border-image: none; border-radius: 50%; animation: 0.6s linear 0s infinite normal none running btn-spin; }

