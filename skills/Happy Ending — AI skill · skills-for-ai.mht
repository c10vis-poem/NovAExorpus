.foot-col a:hover { color: var(--accent); }

.foot-bottom { margin-top: 40px; padding-top: 22px; border-top: 1px solid var(--border-soft); display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 13px; color: var(--text-faint); }

@media (max-width: 900px) {
  .hero-grid { grid-template-columns: 1fr; gap: 12px; }
  .orbstage { height: auto; margin-top: 16px; display: flex; flex-direction: column; align-items: center; gap: 12px; }
  .orb-core { position: static; translate: none; order: 1; }
  .orb-cap { position: static; transform: none; order: 2; width: 100%; max-width: 100%; text-align: center; }
  .orb-term { position: static; translate: none; order: 3; width: 100%; height: 208px; }
  .sell { grid-template-columns: 1fr; gap: 32px; }
  .steps { grid-template-columns: 1fr; }
  .step .line, .nav-links { display: none; }
  .nav-burger { display: inline-flex; }
  .nav-cta, .cart-open, .nav-right > .toggle { display: none !important; }
  .nav-menu.is-open { display: flex; animation: 0.2s ease 0s 1 normal none running nav-menu-in; }
  .contact-grid { grid-template-columns: 1fr; }
}

@media (max-width: 700px) {
  .cat-bar { flex-wrap: wrap; overflow-x: visible; margin-bottom: 28px; }
  .cat-head { align-items: flex-start; }
}

@media (max-width: 480px) {
  .hero-trust { gap: 18px; }
  .prose .data-row { grid-template-columns: 1fr; gap: 2px 0px; }
  .field-row { grid-template-columns: 1fr; }
