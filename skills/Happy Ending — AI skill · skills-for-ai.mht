}

.howto-intro { margin: 0px 0px 28px; padding: 4px 0px 4px 22px; border-left: 3px solid var(--accent-solid); color: var(--text); font-size: clamp(16px, 1.6vw, 18px); line-height: 1.6; font-style: italic; max-width: 62ch; }

.howto-note { margin-top: 22px; padding: 13px 16px; border: 1px solid var(--border-soft); border-radius: 12px; background: var(--bg-soft); color: var(--text-muted); font-size: 14px; line-height: 1.55; display: flex; align-items: flex-start; gap: 10px; }

