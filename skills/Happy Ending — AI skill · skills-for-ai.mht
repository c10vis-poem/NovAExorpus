.sfa-radio .sfa-ctl-box { position: relative; flex: 0 0 auto; width: 21px; height: 21px; margin-top: 1px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--border); display: inline-flex; align-items: center; justify-content: center; transition: background 0.15s, border-color 0.15s; }

.sfa-radio .sfa-ctl-box::after { content: ""; width: 9px; height: 9px; border-radius: 50%; background: rgb(255, 255, 255); transform: scale(0); transition: transform 0.18s cubic-bezier(0.3, 0.9, 0.3, 1); }

