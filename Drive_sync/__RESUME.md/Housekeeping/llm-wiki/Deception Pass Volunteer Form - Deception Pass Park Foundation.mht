:root { --font-base: Montserrat; --font-headings: Sofia Sans Extra Condensed; --font-input: Montserrat; }

body, #content, .entry-content, .post-content, .page-content, .post-excerpt, .entry-summary, .entry-excerpt, .widget-area, .widget, .sidebar, #sidebar, footer, .footer, #footer, .site-footer { font-family: Montserrat; }

