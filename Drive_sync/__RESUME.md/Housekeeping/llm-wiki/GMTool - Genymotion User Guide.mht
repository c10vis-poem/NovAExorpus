@charset "utf-8";

:root > * { --md-primary-fg-color: #e6195e; --md-accent-fg-color: #2b41ea; }

[data-md-color-scheme="slate"] { --md-primary-fg-color: #ffffff; --md-accent-fg-color: #e6195e; }

.md-typeset .md-button.md-button--primary { background: linear-gradient(to right, rgb(230, 25, 94) 0%, rgb(43, 65, 234) 50%, rgb(230, 25, 94) 100%) 0% center / 200%; border-color: transparent; color: rgb(255, 255, 255); transition: background-position 0.6s cubic-bezier(0.25, 1, 0.5, 1); }

.md-typeset .md-button.md-button--primary:hover { background-position: 100% center; border-color: transparent; color: rgb(255, 255, 255); }

@font-face { font-family: Roboto; font-style: normal; font-weight: 400; src: url("../fonts/roboto-v50-latin-regular.woff2") format("woff2"); }

@font-face { font-family: Roboto; font-style: normal; font-weight: 700; src: url("../fonts/roboto-v50-latin-700.woff2") format("woff2"); }

@font-face { font-family: Lato; font-style: normal; font-weight: 400; src: url("../fonts/lato-v25-latin-regular.woff2") format("woff2"); }

@font-face { font-family: Lato; font-style: italic; font-weight: 400; src: url("../fonts/lato-v25-latin-italic.woff2") format("woff2"); }

@font-face { font-family: Lato; font-style: normal; font-weight: 700; src: url("../fonts/lato-v25-latin-700.woff2") format("woff2"); }

:root { --md-text-font: "Lato"; --md-code-font: monospace; }

.md-typeset h1, .md-typeset h2, .md-typeset h3, .md-typeset h4, .md-typeset h5, .md-typeset h6 { font-family: Roboto, sans-serif; font-weight: 700; }
