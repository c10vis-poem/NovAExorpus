.k-push-down-exit-active { transform: translateY(100%); transition: transform 0.3s ease-in-out; }

.k-push-up-enter, .k-push-up-appear { transform: translateY(100%); }

.k-push-up-enter-active, .k-push-up-appear-active { transform: translate(0px); transition: transform 0.3s ease-in-out; }

