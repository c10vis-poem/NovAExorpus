.k-sr-only { position: absolute; left: -1px; width: 1px; height: 1px; overflow: hidden; }

.k-push-right-enter, .k-push-right-appear { transform: translate(-100%); }

.k-push-right-enter-active, .k-push-right-appear-active { transform: translate(0px); transition: transform 0.3s ease-in-out; }

.k-push-right-exit { transform: translate(0px); }

.k-push-right-exit-active { transform: translate(100%); transition: transform 0.3s ease-in-out; }

.k-push-left-enter, .k-push-left-appear { transform: translate(100%); }

.k-push-left-enter-active, .k-push-left-appear-active { transform: translate(0px); transition: transform 0.3s ease-in-out; }

