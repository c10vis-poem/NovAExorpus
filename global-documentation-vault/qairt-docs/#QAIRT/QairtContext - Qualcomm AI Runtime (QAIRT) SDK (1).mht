@charset "utf-8";

pre code.hljs { display: block; overflow-x: auto; }

code.hljs { padding: 3px 5px; }

.hljs { color: var(--color-hljs) !important; background: transparent !important; padding: 0.25em 0em !important; }

.hljs-doctag, .hljs-keyword, .hljs-meta .hljs-keyword, .hljs-template-tag, .hljs-template-variable, .hljs-type, .hljs-variable.language_ { color: var(--color-hljs-doctag) !important; }

.hljs-title, .hljs-title.class_, .hljs-title.class_.inherited__, .hljs-title.function_ { color: var(--color-hljs-title) !important; }

.hljs-link { text-decoration: underline; }

.hljs-attr, .hljs-attribute, .hljs-literal, .hljs-meta, .hljs-number, .hljs-operator, .hljs-selector-attr, .hljs-selector-class, .hljs-selector-id, .hljs-variable { color: var(--color-hljs-attr) !important; }

.hljs-meta .hljs-string, .hljs-regexp, .hljs-string { color: var(--color-hljs-meta) !important; }

.hljs-built_in, .hljs-symbol { color: var(--color-hljs-built) !important; }

.hljs-code, .hljs-comment, .hljs-formula { color: var(--color-hljs-code) !important; }

.hljs-name, .hljs-quote, .hljs-selector-pseudo, .hljs-selector-tag { color: var(--color-hljs-name) !important; }

.hljs-subst, .hljs-emphasis, .hljs-strong { color: var(--color-hljs-subst) !important; }

.hljs-section { color: var(--color-hljs-section) !important; font-weight: 660; }

.hljs-bullet { color: var(--color-hljs-bullet) !important; }

.hljs-emphasis { font-style: italic; }

.hljs-strong { font-weight: 660; }

.hljs-addition { display: inline-block; width: 100%; color: var(--color-hljs-add) !important; background-color: var(--color-hljs-add-bg) !important; }

.hljs-deletion { display: inline-block; width: 100%; color: var(--color-hljs-del) !important; background-color: var(--color-hljs-del-bg) !important; }
