h1, h2, h3, h4, h5, h6 { font-family: Qualcomm-Next, "Roboto Flex", sans-serif; font-variation-settings: var(--roboto-flex-variation); }

.html-no-scroll { overflow: hidden; }

body { letter-spacing: 0.2px; -webkit-font-smoothing: antialiased; background-color: var(--color-background) !important; color: var(--color-front) !important; padding: 0px !important; position: initial !important; }

.col-xl-8 { max-width: 1200px; }

.contentmodule { padding: 0px 0px 12px 48px; width: calc(100% - 355px); border-left: 1px solid var(--color-model-border); flex-grow: 1; }

td pre code { min-width: 50px !important; }

@media (max-width: 1400px) {
  pre code { min-width: 92% !important; }
}

@media (max-width: 992px) {
  .contentmodule { margin-left: 0px; }
  pre code { min-width: 90% !important; }
  .security-bulletin-content td.entry.cellrowborder { word-break: break-word; }
  .page-content table, .security-bulletin-content table { display: block !important; table-layout: fixed !important; width: fit-content !important; white-space: nowrap !important; }
