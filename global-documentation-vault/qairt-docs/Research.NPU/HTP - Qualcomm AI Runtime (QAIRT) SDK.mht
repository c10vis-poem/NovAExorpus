<span class="hljs-number">13</span>    <span class="hljs-built_in">doCreateFromBinary</span>(QNN_CONTEXT_BINARY_COMPATIBILITY_PERMISSIVE, &amp;context);
<span class="hljs-number">14</span>  } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (result = QNN_CONTEXT_ERROR_CREATE_FROM_BINARY) {
