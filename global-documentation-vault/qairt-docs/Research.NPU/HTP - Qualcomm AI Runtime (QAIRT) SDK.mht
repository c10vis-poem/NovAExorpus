<span class="hljs-number">22</span>      <span class="hljs-comment">// graph. In such case, prompt the users to upgrade HNRD.</span>
<span class="hljs-number">23</span>      <span class="hljs-built_in">message</span>(ERROR, <span class="hljs-string">"The HNRD is too old. Please install latest HNRD."</span>);
<span class="hljs-number">24</span>    }
