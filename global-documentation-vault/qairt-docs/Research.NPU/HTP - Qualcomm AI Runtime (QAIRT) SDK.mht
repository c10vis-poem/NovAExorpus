  pre code { min-width: 82% !important; }
}

.contentmodule .container, .contentmodule .row { all: revert; }

.contentmodule table .row > * { width: auto; }

.metadata { font-size: 12px; letter-spacing: 0.5px; line-height: 1.25; color: rgb(187, 192, 200); }

.eyebrow { font-weight: 500; line-height: 100%; text-transform: uppercase; color: var(--color-content); font-family: Alfabet, "Roboto Flex"; font-size: 12px !important; }

div.note, li.li, li.link { font-size: 17px; letter-spacing: 0px; line-height: 26px; color: var(--color-content); margin-bottom: 16px; }

div.line { font-size: 14px !important; }

p, div.p, div.line { font-size: 16px; letter-spacing: 0px; line-height: 24px; color: var(--color-content); margin-bottom: 16px; font-weight: 400; }

.p { overflow-wrap: break-word; }

div.noteinline.admonition.note > p { font-family: "Roboto Flex"; font-style: normal; font-weight: 400; color: var(--color-front); font-size: 14px !important; line-height: 20px !important; }

div.note, div.note > p { font-size: 16px !important; line-height: 24px !important; }

div.note > p { margin-top: 0px !important; margin-bottom: 0px !important; }

.p-small { font-size: 14px; letter-spacing: 0.2px; line-height: 1.8; }

li.li { margin-bottom: 8px; }

li ul, li ol { margin-top: 8px; }

.sectiontitle, section h1, section h2, section h3, section h4, .section h1, .section h2, .section h3, .section h4, .topictitle2, .topictitle3, .topictitle4, .title, .overview, .section > .sectiontitle { color: var(--color-header) !important; }

h2.heading-xs { font-size: 17px !important; }

.attentiontitle, .warningtitle, .cautiontitle, .notetitle, .admonition-title, p.admonition-title { display: flex; padding-bottom: 8px; font-weight: 600 !important; font-size: 14px !important; margin-bottom: 0px !important; }

.warningtitle, .cautiontitle, .admonition.warning > p.admonition-title, .admonition.caution > p.admonition-title { color: var(--color-warning-title-fg); }

.admonition.danger > p.admonition-title, .admonition.error > p.admonition-title { color: var(--color-error-title-fg); }

.admonition.important > p.admonition-title, .admonition.hint > p.admonition-title, .admonition.tip > p.admonition-title { color: var(--color-hint-title-fg); }

.admonition.danger > p.admonition-title::before, .admonition.error > p.admonition-title::before { margin-right: 5px; font-size: 16px; content: "â®¾" !important; }

.admonition.important > p.admonition-title::before, .admonition.hint > p.admonition-title::before, .admonition.tip > p.admonition-title::before { margin-right: 5px; font-size: 16px; content: "ðŸ’¡" !important; }

.notetitle, .attentiontitle, .admonition.note > p.admonition-title, .admonition.attention > p.admonition-title { color: var(--color-content); }

.notetitle svg, .attentiontitle svg, .warningtitle svg, .cautiontitle svg, .admonition-title svg { margin-right: 5px; }

.note.attention, .note.warning, .note.caution, .admonition.important, .admonition.attention, .admonition.warning, .admonition.caution, .admonition.danger, .admonition.error, .admonition.hint, .admonition.tip { padding: 16px 24px 12px; }

.note, .note.attention, .admonition.attention { border-left: 3px solid var(--color-note-border); color: var(--color-content); padding: 16px 24px; font-size: 16px; font-style: normal; font-weight: 400; line-height: 24px; background: var(--color-note-bg) !important; }

.note.warning, .note.caution, .admonition.warning, .admonition.caution { background: var(--color-warning-bg); border-left: 3px solid var(--color-warning-border); color: var(--color-warning-fg); }

.admonition.danger, .admonition.error { background: var(--color-error-bg); border-left: 3px solid var(--color-error-title-fg); color: var(--color-warning-fg); }

.admonition.important, .admonition.hint, .admonition.tip { background: var(--color-hint-bg); border-left: 3px solid var(--color-hint-title-fg); color: var(--color-warning-fg); margin-bottom: 16px; }

.noteinline.admonition.note { display: inline-flex; border-left-width: medium; border-left-style: none; border-left-color: currentcolor; padding-left: 0px; margin-bottom: 0px; padding-top: 0px; background: none !important; }

.noteinline > p.admonition-title { min-width: 60px; max-height: 60px; margin-right: -33px; color: transparent !important; }

.noteinline > p { font-family: "Roboto Flex"; font-size: 14px; font-style: normal; font-weight: 400; line-height: 20px; color: var(--color-front); }

.noteinline > p.admonition-title svg { stroke: var(--color-navigation-link); }

.wintitle, .uicontrol, p.sidebar-title, p.rubric, .guilabel { font-weight: 700 !important; }

