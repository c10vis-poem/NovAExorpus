<span class="hljs-number">12</span><span class="hljs-keyword">if</span> (QNN_SUCCESS != qnnStatus) {
<span class="hljs-number">13</span>    <span class="hljs-comment">// handle errors</span>
<span class="hljs-number">14</span>}
