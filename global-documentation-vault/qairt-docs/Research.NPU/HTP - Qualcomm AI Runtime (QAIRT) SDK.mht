                        <span class="hljs-string">"loadFromCachedBinary"</span>: <span class="hljs-literal">true</span>,
                        <span class="hljs-string">"inputPath"</span>: &lt;filename_for_input_list&gt;,
                        <span class="hljs-string">"inputDataType"</span>: <span class="hljs-string">"FLOAT"</span>,
                        <span class="hljs-string">"outputPath"</span>: <span class="hljs-string">"model_low_output"</span>,
                        <span class="hljs-string">"outputDataType"</span>: <span class="hljs-string">"FLOAT_ONLY"</span>,
                        <span class="hljs-string">"saveOutput"</span>: <span class="hljs-string">"NATIVE_LAST"</span>
                }
        ],
        <span class="hljs-string">"contexts"</span>: [
                {
                        <span class="hljs-string">"contextName"</span>: <span class="hljs-string">"context_1"</span>,
                        <span class="hljs-string">"priority"</span> : <span class="hljs-string">"LOW"</span>
                }
        ],
        <span class="hljs-string">"testCase"</span>: {
                <span class="hljs-string">"logLevel"</span>: <span class="hljs-string">"error"</span>,
                <span class="hljs-string">"threads"</span>: [
                        {
                                <span class="hljs-string">"threadName"</span>: <span class="hljs-string">"thread_1"</span>,
                                <span class="hljs-string">"backend"</span>: <span class="hljs-string">"backend_1"</span>,
                                <span class="hljs-string">"context"</span>: <span class="hljs-string">"context_1"</span>,
