<span class="hljs-number">31</span>  futureContext = std::<span class="hljs-built_in">async</span>(std::launch::async, doOnlinePrepare, HTP_OPTIMIZATION_LEVEL_3,
<span class="hljs-number">32</span>                             SAVE_CONTEXT);
