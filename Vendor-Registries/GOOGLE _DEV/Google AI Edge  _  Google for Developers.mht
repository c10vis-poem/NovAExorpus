@charset "utf-8";

.googledevai-theme[layout="full"] { --devsite-banner-margin: -40px calc(50% - 50vw + var(--devsite-concierge-width)/2) 0; --devsite-main-content-padding: 20px 24px; --devsite-main-content-max-width: 1600px; }

.googledevai-theme .devsite-article-body { margin-top: 0px; }

.edge-page { --gemini-size-grid-gap: 24px; --edge-color-black: #1f2125; --edge-color-white: #fff; --edge-color-blue: #1a73e8; --edge-color-grey-900: #202124; --edge-color-grey-700: #606060; --edge-color-grey-50: #f8f9fc; --edge-color-blue-600: #1c8cde; --edge-color-blue-100: #c2e7ff; --edge-color-blue-900: #004a77; --edge-color-blue-50: #f4f8fe; --edge-color-green-50: #f4faf6; --edge-color-border: rgba(33, 34, 38, 0.12); --edge-primary-font: 'Google Sans', sans-serif; --edge-secondary-font: 'Google Sans Text', sans-serif; --edge-space-d88: 80px; color: var(--edge-color-grey-900); }

@media (min-width: 768px) {
  .edge-page { --edge-space-d88: 88px; }
}

.edge-page .edge-layout-grid { display: grid; grid-template-columns: repeat(6, minmax(0px, 1fr)); gap: var(--gemini-size-grid-gap); }

@media (min-width: 768px) {
  .edge-page .edge-layout-grid { grid-template-columns: repeat(8, minmax(0px, 1fr)); }
}

@media (min-width: 1024px) {
  .edge-page .edge-layout-grid { grid-template-columns: repeat(12, minmax(0px, 1fr)); }
}

.edge-hero { position: relative; width: 100%; border-bottom-left-radius: 32px; border-bottom-right-radius: 32px; padding-block: 64px 0px; container-type: inline-size; margin-block-end: var(--edge-space-d88); z-index: 0; }

@media (min-width: 1024px) {
  .edge-hero { padding-block: 183px; }
}

.edge-hero::before, .edge-display-cards::before, .edge-mobile-app-callout::before { content: ""; position: absolute; inset: 0px; inset-inline: -24px; background: var(--edge-color-black); z-index: -1; border-radius: inherit; }

@media (min-width: 768px) {
  .edge-hero::before, .edge-display-cards::before, .edge-mobile-app-callout::before { inset-inline: 0px; }
}

.edge-hero-image-wrapper { position: relative; width: 100%; z-index: 1; grid-column: 1 / -1; margin-block-start: 32px; }

@media (min-width: 1024px) {
  .edge-hero-image-wrapper { position: absolute; inset: 0px; overflow: hidden; margin-block-start: 0px; border-radius: inherit; }
}

.edge-hero-image-container { width: 100%; position: relative; overflow: hidden; border-radius: inherit; }

@media (min-width: 1024px) {
  .edge-hero-image-container { position: absolute; bottom: -4cqw; right: -16cqw; width: 57cqw; }
}

.edge-hero-image { display: block; width: 100%; height: auto; }

.edge-hero-content { grid-column: 1 / -1; position: relative; z-index: 5; display: flex; flex-direction: column; align-items: center; text-align: center; }

@media (min-width: 1024px) {
  .edge-hero-content { grid-column: 2 / span 6; align-items: flex-start; text-align: left; }
}

.edge-hero-headline { font-family: var(--edge-primary-font); font-weight: 500; font-size: 40px; line-height: 1.1; letter-spacing: -2px; margin: 0px; color: var(--edge-color-white); }

@media (min-width: 1024px) {
  .edge-hero-headline { font-size: 72px; }
}

.edge-hero-description { font-family: var(--edge-secondary-font); font-weight: 400; font-size: 16px; line-height: normal; letter-spacing: 0px; margin-block: 32px 0px; color: var(--edge-color-white); max-inline-size: 330px; }

.edge-hero-button { display: inline-block; padding: 12px 18px; background-color: var(--edge-color-blue); border-radius: 100px; font-family: var(--edge-primary-font); font-weight: 500; font-size: 16px; line-height: 1.4; letter-spacing: 0px; margin-block-start: 40px; color: var(--edge-color-white); text-decoration: none; border-width: medium; border-style: none; border-color: currentcolor; border-image: initial; cursor: pointer; }

.edge-feature-cards { margin-block-end: var(--edge-space-d88); }

.edge-feature-cards-dash-line-container { grid-column: 1 / -1; display: flex; flex-direction: column; gap: 16px; margin-block-start: 24px; width: calc(100% - ((100% - 2 * var(--gemini-size-grid-gap)) / 4)); justify-self: center; }

@media (min-width: 1024px) {
  .edge-feature-cards-dash-line-container { grid-column: 1 / -1; width: 100%; }
}

.edge-feature-cards-dash-line { position: relative; height: 2px; background-image: linear-gradient(90deg, var(--edge-color-grey-700) 50%, transparent 50%); background-size: 16px 2px; background-repeat: repeat-x; width: 100%; }

.edge-feature-cards-dash-line::before, .edge-feature-cards-dash-line::after { content: ""; position: absolute; top: 50%; transform: translateY(-50%); border-style: solid; }

.edge-feature-cards-dash-line::before { left: 0px; border-width: 6px 10px 6px 0px; border-color: transparent var(--edge-color-grey-700) transparent transparent; }

.edge-feature-cards-dash-line::after { right: 0px; border-width: 6px 0px 6px 10px; border-color: transparent transparent transparent var(--edge-color-grey-700); }

.edge-feature-cards-dash-labels { display: flex; justify-content: space-between; }

.edge-feature-cards-dash-label-block { display: flex; align-items: center; gap: 8px; }

.edge-feature-cards-dash-label { font-family: var(--edge-primary-font); font-weight: 700; font-size: 14px; color: var(--edge-color-grey-900); text-transform: uppercase; }

.edge-feature-cards-section-headline { grid-column: 1 / -1; font-family: var(--edge-primary-font); font-weight: 500; font-size: 30px; line-height: 32px; letter-spacing: -2px; margin-block: 0px 24px; }

@media (min-width: 1024px) {
  .edge-feature-cards-section-headline { grid-column: 2 / span 10; font-size: 48px; line-height: 56px; margin-block: 0px 40px; }
}

.edge-feature-cards-wrapper { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 85%); overflow-x: auto; scroll-snap-type: x mandatory; gap: var(--gemini-size-grid-gap); padding-bottom: 8px; }

@media (min-width: 1024px) {
