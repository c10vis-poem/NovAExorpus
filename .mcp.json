{
  "mcpServers": {
    "omniroute": {
      "type": "http",
      "url": "${OMNIROUTE_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${OMNIROUTE_API_KEY}"
      }
    },
    "mem0": {
      "type": "http",
      "url": "${MEM0_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${MEM0_MCP_TOKEN}"
      }
    },
    "terrestrial-brain": {
      "type": "http",
      "url": "${TB_MCP_URL}",
      "headers": {
        "x-brain-key": "${TB_MCP_KEY}"
      }
    }
  }
}
