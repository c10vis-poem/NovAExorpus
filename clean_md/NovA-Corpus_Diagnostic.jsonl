{"id": "nova-corpus-diagnostic#p7#b197", "text": "AWAITING YOU", "metadata": {"source": "nova-corpus-diagnostic", "page": 7, "type": "paragraph"}}
{"id": "nova-corpus-diagnostic#p7#b198", "text": "scope", "metadata": {"source": "nova-corpus-diagnostic", "page": 7, "type": "paragraph"}}
{"id": "nova-corpus-diagnostic#p7#b199", "text": "How much to do in one go", "metadata": {"source": "nova-corpus-diagnostic", "page": 7, "type": "paragraph"}}
